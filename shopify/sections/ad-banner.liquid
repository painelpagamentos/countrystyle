{%- if section.settings.show_adbanner -%}
  {%- assign desktop_banner = section.settings.desktop_banner -%}
  {%- assign mobile_banner = section.settings.mobile_banner | default: desktop_banner -%}

  {%- comment -%}Fallback: banners da loja ao vivo quando imagens do editor não estão configuradas{%- endcomment -%}
  {%- if desktop_banner == blank -%}
    {%- assign desktop_banner_url = 'https://yunabella.myshopify.com/cdn/shop/files/yuna2_1920x50.png?v=1787586512' -%}
    {%- assign mobile_banner_url = 'https://yunabella.myshopify.com/cdn/shop/files/yuna2_750x83.png?v=1787586512' -%}
  {%- else -%}
    {%- assign desktop_banner_url = desktop_banner | img_url: '1920x50' -%}
    {%- assign mobile_banner_url = mobile_banner | img_url: '750x83' -%}
  {%- endif -%}

  <section data-section-id="{{ section.id }}" data-section-type="top-banner" data-section-settings="{{ section_settings }}">
    <div id="ad-banner">
      {%- if section.settings.ad_link != blank -%}
        <a href="{{ section.settings.ad_link }}" id="ad-banner-link" class="ad-banner__link">
      {%- endif -%}

      <picture>
        <source media="(min-width: 701px)" srcset="{{ desktop_banner_url }}">
        <img
          id="ad-image"
          class="banner"
          src="{{ mobile_banner_url }}"
          alt="{{ shop.name }}"
          width="750"
          height="83"
          loading="eager"
          fetchpriority="high">
      </picture>

      {%- if section.settings.ad_link != blank -%}
        </a>
      {%- endif -%}
    </div>
  </section>

  {% if section.settings.active_infinite_banner %}
    <script>
        $(document).ready(function () {
            if ($.fn.simplyScroll) { $("#ad-banner").simplyScroll(); }

            $(".banner").on("touchstart", function () {
                this.click();
            });

            {% if section.settings.ad_link %}
                $(".simply-scroll-clip").on("click touchstart", function() {
                    window.location.href = '{{ section.settings.ad_link.url | default: section.settings.ad_link }}';
                });
            {% endif %}
        });
    </script>
  {% endif %}

  <style>
    #ad-banner {
      background-color: {{ section.settings.background_color }};
      line-height: 0;
      overflow: hidden;
    }

    #ad-banner .ad-banner__link {
      display: block;
      cursor: pointer;
    }

    #ad-banner img.banner {
      display: block;
      width: 100%;
      height: auto;
      margin: 0 auto;
      background-color: {{ section.settings.background_color }};
    }

    .simply-scroll-container {
      position: relative;
    }

    .simply-scroll-clip {
      position: relative;
      overflow: hidden;
    }

    .simply-scroll-list {
      width: auto !important;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Banner de anúncio",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_adbanner",
      "label": "Mostrar banner de anúncio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "active_infinite_banner",
      "label": "Ativar banner infinito",
      "default": false
    },
    {
      "type": "url",
      "id": "ad_link",
      "label": "Link do anúncio",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Imagens"
    },
    {
      "type": "image_picker",
      "id": "desktop_banner",
      "label": "Banner / Desktop",
      "info": "1920 x 60px .png recomendado"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner",
      "label": "Banner / Mobile",
      "info": "750 x 83px .png recomendado"
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor do fundo",
      "default": "#80007f"
    }
  ]
}
{% endschema %}
