  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "helvetica_n4"
      },
      {
        "type": "font_picker",
        "id": "text_font",
        "label": "Text font",
        "default": "helvetica_n4"
      },
      {
        "type": "range",
        "id": "base_text_font_size",
        "label": "Base font size",
        "min": 13,
        "max": 17,
        "step": 1,
        "default": 15
      },
      {
        "type": "checkbox",
        "id": "underline_links",
        "label": "Underline links",
        "default": false
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "select",
        "id": "icone_carrinho",
        "label": "Cart icon",
        "options": [
          { "value": "cart", "label": "Cart" },
          { "value": "bag", "label": "Bag" }
        ],
        "default": "bag"
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_threshold",
        "label": "Show free shipping threshold",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold (R$)",
        "default": "100"
      },
      {
        "type": "url",
        "id": "cart_empty_button_link",
        "label": "Empty cart button link",
        "default": "/collections/all"
      },
      {
        "type": "checkbox",
        "id": "cart_show_checkout_button",
        "label": "Show checkout button in drawer",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "select",
        "id": "search_mode",
        "label": "Search mode",
        "options": [
          { "value": "product", "label": "Products only" },
          { "value": "product,article,page", "label": "Products, articles and pages" }
        ],
        "default": "product"
      }
    ]
  },
  {
