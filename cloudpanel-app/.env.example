# Copie este arquivo para .env e preencha os valores reais.
# O .env NÃO deve ser commitado nem enviado a repositórios públicos.

# Chave de API da Corvex (painel Corvex > Integrações > API)
CORVEX_API_KEY=sua-chave-api-corvex

# Base da API Corvex (manter este valor)
CORVEX_API_BASE=https://apiv3.usecorvex.com.br

# Secret usado para validar a assinatura HMAC dos webhooks.
# Gere uma string aleatória (ex.: 64 chars hex) e cadastre o MESMO valor
# no painel Corvex ao registrar o webhook.
CORVEX_WEBHOOK_SECRET=seu-secret-aleatorio-de-64-caracteres

# URL pública do site em produção (usada no retorno do checkout)
PUBLIC_BASE_URL=https://yunabella.com

# Banco de dados Supabase (valores públicos do binding Verdent/Supabase).
# Usados pelo webhook para gravar pedidos nas tabelas orders/order_items.
SUPABASE_URL=https://sua-instancia-supabase
SUPABASE_ANON_KEY=sua-chave-publica-anon

# Opcionais (valores padrão mostrados):
# PORT=3000
# HOST=127.0.0.1
