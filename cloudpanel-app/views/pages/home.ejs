<%- include('../partials/head') %>
<%- include('../partials/pre-header', { template: 'index' }) %>
<%- include('../partials/header') %>

<div id="main" class="main-content">

  <section class="section-home section-home-slider d-none d-md-block" data-store="home-main-slider">
    <div class="js-home-slider" id="home-slider-desktop">
      <%
        var slidesDesktop = [
          '/assets/banners/slide-d1.webp',
          '/assets/banners/slide-d2.webp',
          '/assets/banners/slide-d3.webp',
          '/assets/banners/slide-d4.webp',
          '/assets/banners/slide-d5.webp',
          '/assets/banners/slide-d6.webp'
        ];
        var slidesMobile = [
          '/assets/banners/slide-m1.webp',
          '/assets/banners/slide-m2.webp',
          '/assets/banners/slide-m3.webp',
          '/assets/banners/slide-m4.webp',
          '/assets/banners/slide-m5.webp',
          '/assets/banners/slide-m6.webp'
        ];
      %>
      <% slidesDesktop.forEach(function (src, i) { %>
      <a href="/collections/mais-vendidos" class="home-slide <%= i === 0 ? 'active' : '' %>">
        <img src="<%= src %>" alt="Carrossel <%= i + 1 %>" width="1600" height="534" <%= i === 0 ? 'fetchpriority="high" decoding="async"' : 'loading="lazy" decoding="async"' %>>
      </a>
      <% }) %>
      <button type="button" class="home-slider-prev" aria-label="Anterior"><svg class="icon-inline icon-lg icon-flip-horizontal"><use xlink:href="#chevron"/></svg></button>
      <button type="button" class="home-slider-next" aria-label="Próximo"><svg class="icon-inline icon-lg"><use xlink:href="#chevron"/></svg></button>
    </div>
  </section>

  <section class="section-home section-home-slider d-md-none" data-store="home-main-slider">
    <div class="js-home-slider" id="home-slider-mobile">
      <% slidesMobile.forEach(function (src, i) { %>
      <a href="/collections/mais-vendidos" class="home-slide <%= i === 0 ? 'active' : '' %>">
        <img src="<%= src %>" alt="Carrossel <%= i + 1 %>" width="828" height="574" <%= i === 0 ? 'fetchpriority="high" decoding="async"' : 'loading="lazy" decoding="async"' %>>
      </a>
      <% }) %>
      <button type="button" class="home-slider-prev" aria-label="Anterior"><svg class="icon-inline icon-lg icon-flip-horizontal"><use xlink:href="#chevron"/></svg></button>
      <button type="button" class="home-slider-next" aria-label="Próximo"><svg class="icon-inline icon-lg"><use xlink:href="#chevron"/></svg></button>
    </div>
  </section>

  <section class="section-home section-informative-banners" data-store="banner-services">
    <div class="container">
      <div class="services-row">
        <div class="service-item">
          <div class="service-image"><svg class="icon-inline service-icon"><use xlink:href="#truck"/></svg></div>
          <div class="service-text">
            <div class="service-title mb-1 w-100">GANHE FRETE GRÁTIS</div>
            <p class="m-0">Em compras acima de R$ 300 para Sul, Sudeste e Centro-Oeste</p>
          </div>
        </div>
        <div class="service-item">
          <div class="service-image"><svg class="icon-inline service-icon"><use xlink:href="#credit-card"/></svg></div>
          <div class="service-text">
            <div class="service-title mb-1 w-100">ATÉ 10X SEM JUROS</div>
            <p class="m-0">Parcele usando o seu cartão de crédito</p>
          </div>
        </div>
        <div class="service-item">
          <a href="https://instagram.com/country_stylemodas" class="banner-services-link" target="_blank" rel="noopener">
            <div class="service-image"><svg class="icon-inline service-icon"><use xlink:href="#barcode"/></svg></div>
            <div class="service-text">
              <div class="service-title mb-1 w-100">PROMOÇÕES DIÁRIAS NO INSTAGRAM</div>
              <p class="m-0">Clique aqui e fique por dentro das nossas melhores ofertas</p>
            </div>
          </a>
        </div>
        <div class="service-item">
          <div class="service-image"><svg class="icon-inline service-icon"><use xlink:href="#tag"/></svg></div>
          <div class="service-text">
            <div class="service-title mb-1 w-100">COMPRE NO PIX COM 10% OFF</div>
            <p class="m-0">Pague via Pix e ganhe desconto na sua compra</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-home section-categories" data-store="home-categories">
    <div class="container">
      <div class="section-title section-title-uppercase mx-auto row">
        <div class="col-12 text-center">
          <h2 class="text-heading mb-0">Compre por categoria 🤠</h2>
        </div>
      </div>
      <%
        var categories = [
          { label: 'Mais Vendidos', href: '/collections/mais-vendidos', img: '/assets/banners/cat1.webp' },
          { label: 'Chapéus', href: '/collections/chapeu', img: '/assets/banners/cat2.webp' },
          { label: 'Calças Femininas', href: '/collections/mulheres-roupas-calcas', img: '/assets/banners/cat3.webp' },
          { label: 'Calças Masculinas', href: '/collections/homens-roupas-masculinas-calcas-masculinas', img: '/assets/banners/cat4.webp' },
          { label: 'Botas Femininas', href: '/collections/mulheres-botas-femininas', img: '/assets/banners/cat5.webp' },
          { label: 'Botas Masculinas', href: '/collections/homens-botas', img: '/assets/banners/cat6.webp' },
          { label: 'Kits Femininos', href: '/collections/kits-monte-aqui-seu-kit-feminino3', img: '/assets/banners/cat7.webp' },
          { label: 'Kits Masculinos', href: '/collections/kits-monte-aqui-seu-kit-masculino3', img: '/assets/banners/cat8.webp' },
          { label: 'Blusas e Camisetas', href: '/collections/mulheres-roupas-blusas-e-camisetas', img: '/assets/banners/cat9.webp' },
          { label: 'Camisetas', href: '/collections/ofertas-blusinhas-e-camisetas', img: '/assets/banners/cat10.webp' },
          { label: 'Camisas Femininas', href: '/collections/mulheres-roupas-camisas-femininas-manga-longa', img: '/assets/banners/cat11.webp' },
          { label: 'Camisas', href: '/collections/homens-roupas-masculinas-camisas', img: '/assets/banners/cat12.webp' },
          { label: 'Bonés', href: '/collections/homens-bones-masculinos', img: '/assets/banners/cat13.webp' },
          { label: 'Lançamentos', href: '/collections/mulheres-lancamento', img: '/assets/banners/cat14.webp' }
        ];
      %>
      <div class="container position-relative px-0 px-md-3">
        <div class="js-swiper-categories home-categories-swiper">
          <div class="home-categories-track js-cats-track">
            <% categories.forEach(function (cat) { %>
            <div class="home-category text-center">
              <a href="<%= cat.href %>" class="js-home-category" aria-label="<%= cat.label %>">
                <div class="home-category-image category-circle">
                  <img class="textbanner-image-effect img-fluid d-block w-100" src="<%= cat.img %>" alt="<%= cat.label %>" loading="lazy" width="320" height="320">
                </div>
              </a>
            </div>
            <% }) %>
          </div>
        </div>
        <div class="js-swiper-categories-prev swiper-button-prev d-none d-md-block svg-icon-text js-cats-prev" role="button" aria-label="Categorias anteriores">
          <svg class="icon-inline icon-lg icon-flip-horizontal"><use xlink:href="#chevron"/></svg>
        </div>
        <div class="js-swiper-categories-next swiper-button-next d-none d-md-block svg-icon-text js-cats-next" role="button" aria-label="Próximas categorias">
          <svg class="icon-inline icon-lg"><use xlink:href="#chevron"/></svg>
        </div>
      </div>
    </div>
  </section>

  <section class="section-home section-featured-home section-new-products-home section-new-products-home-colors section-home-color" data-store="home-products-new">
    <div class="container">
      <div class="section-title section-title-uppercase mx-auto row">
        <div class="col-12 text-center">
          <h2 class="text-heading mb-0">Lançamentos 🤠</h2>
        </div>
        <div class="col-12 text-center mt-2">
          <p class="home-subtitle text-subtitle">Confira as nossas últimas novidades</p>
        </div>
      </div>
      <div class="row row-grid animation-container">
        <% products.slice(0, 12).forEach(function (p) { %>
        <%- include('../partials/product-item', { product: p, grid_classes: 'col-6 col-md-2' }) %>
        <% }) %>
      </div>
      <div class="row">
        <div class="col-12 text-center mt-4">
          <a href="/collections/mais-vendidos" class="btn btn-secondary">Ver todos os produtos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-home section-banners-home section-banners-featured position-relative" data-store="home-banner-featured">
    <div class="container">
      <a href="/collections/ofertas">
        <img class="w-100 d-block d-md-none" src="/assets/banners/banner-ofertas-m.webp" alt="Banner Ofertas" loading="lazy" width="828" height="276">
        <img class="w-100 d-none d-md-block" src="/assets/banners/banner-ofertas-d.webp" alt="Banner Ofertas" loading="lazy" width="1200" height="188">
      </a>
    </div>
  </section>

  <section class="home-promos section-home" data-store="home-banner-products">
    <div class="container mb-3">
      <div class="section-title section-title-uppercase mx-auto row">
        <div class="col-12 text-center">
          <h2 class="text-heading mb-0">CONHEÇA A TEX TEAM</h2>
        </div>
      </div>
    </div>
    <div class="container">
      <a href="/collections/tex-team" class="item-banner d-block">
        <img class="w-100 d-block d-md-none" src="/assets/banners/banner-texteam-m.webp" alt="Conheça a Tex Team" loading="lazy" width="828" height="828">
        <img class="w-100 d-none d-md-block" src="/assets/banners/banner-texteam-d.webp" alt="Conheça a Tex Team" loading="lazy" width="1200" height="1800">
      </a>
    </div>
  </section>

  <section class="section-home section-banners-home section-banners-promotional position-relative" data-store="home-banner-promotional">
    <div class="container">
      <div class="section-title section-title-uppercase mx-auto row">
        <div class="col-12 text-center">
          <h2 class="text-heading mb-0">Conheça nossos Kits 👢</h2>
        </div>
      </div>
      <div class="row justify-content-center">
        <div class="col-12 col-md-4 textbanner">
          <a href="/collections/kits-monte-aqui-seu-kit-feminino3" class="textbanner-link" aria-label="Kits Femininos">
            <img class="w-100 d-block" src="/assets/banners/banner-kits-f.webp" alt="Kits Femininos" loading="lazy" width="640" height="320">
          </a>
        </div>
        <div class="col-12 col-md-4 textbanner">
          <a href="/collections/kits-monte-aqui-seu-kit" class="textbanner-link" aria-label="Kits Masculinos / Casal">
            <img class="w-100 d-block" src="/assets/banners/banner-kits-m.webp" alt="Kits Casal" loading="lazy" width="640" height="320">
          </a>
        </div>
      </div>
    </div>
  </section>

</div>

<%- include('../partials/footer') %>
