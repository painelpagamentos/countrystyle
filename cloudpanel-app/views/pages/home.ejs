          <p class="home-subtitle text-subtitle">Confira as nossas últimas novidades</p>
        </div>
      </div>
      <div class="row row-grid animation-container">
        <% products.slice(0, 12).forEach(function (p) { %>
        <%- include('../partials/product-item', { product: p, grid_classes: 'col-6 col-md-2' }) %>
        <% }) %>
      </div>
      <div class="row">
        <div class="col-12 text-center mt-4">
          <a href="/collections/mais-vendidos" class="btn btn-secondary">Ver todos os produtos</a>
        </div>
      </div>
    </div>
