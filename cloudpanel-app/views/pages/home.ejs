          'https://acdn-us.mitiendanube.com/stores/002/071/006/themes/flex/1-slide-1785532719959-7999060274-08809a70482235c116245c19baeb78211785532724-1920-1920.webp?3492836936039090351',
          'https://acdn-us.mitiendanube.com/stores/002/071/006/themes/flex/1-slide-1785532719957-7650111922-5afa45f53b43635c4f8dcc4e6d9542041785532721-1920-1920.webp?3492836936039090351',
          'https://acdn-us.mitiendanube.com/stores/002/071/006/themes/flex/1-slide-1785532719958-4620468828-3a53143c9a20d68eccae7a21bf967b051785532722-1920-1920.webp?3492836936039090351',
